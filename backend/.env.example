# Local default is SQLite. Production: the Neon connection string (keep ?sslmode=require).
DATABASE_URL=sqlite:///./smartwardrobe.db

# Long random string; signs login tokens. Required with Postgres.
SECRET_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Public URL of this API (image links). Production: https://<user>-smartwardrobe-api.hf.space
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Web app origins allowed to call the API (comma-separated). Empty = all.
CORS_ORIGINS=

# Image storage: db (default) or s3 (Cloudflare R2 etc.)
STORAGE_BACKEND=db
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=smartwardrobe
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://images.example.com

# Limits
# ANALYZE_LIMIT=30/hour
# SUGGEST_LIMIT=20/hour
# DEMO_LIMIT=10/hour
# DEMO_TTL_HOURS=24
